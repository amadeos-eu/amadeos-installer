<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- amadeOS: the installer wizard (amadeos-installer) runs /usr/sbin/amadeos-install through pkexec.
     50-amadeos-installer.rules allows it to members of sudo without a prompt; everyone else needs
     the administrator's password. -->
<policyconfig>
  <vendor>amadeOS</vendor>
  <vendor_url>https://github.com/amadeos-eu/amadeos</vendor_url>
  <action id="eu.amadeos.installer.install">
    <description>Install amadeOS onto a disk</description>
    <description xml:lang="de">amadeOS auf eine Festplatte installieren</description>
    <description xml:lang="fr">Installer amadeOS sur un disque</description>
    <description xml:lang="es">Instalar amadeOS en un disco</description>
    <description xml:lang="it">Installare amadeOS su un disco</description>
    <message>Authentication is required to install amadeOS onto a disk</message>
    <message xml:lang="de">Zum Installieren von amadeOS auf eine Festplatte ist eine Authentifizierung erforderlich</message>
    <message xml:lang="fr">Une authentification est requise pour installer amadeOS sur un disque</message>
    <message xml:lang="es">Se requiere autenticación para instalar amadeOS en un disco</message>
    <message xml:lang="it">È richiesta l'autenticazione per installare amadeOS su un disco</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/sbin/amadeos-install</annotate>
  </action>
</policyconfig>
